NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/help_desk

# Required: generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_min_32_chars

# Required for AI ticket classification (server-side only, never exposed to
# the browser). The AI endpoint returns 503 when these are not set.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional per-request AI timeout in ms (minimum 1000, default 15000)
# GROQ_TIMEOUT_MS=15000

# Required in production: the exact origin of your frontend (no trailing slash)
# FRONTEND_ORIGIN=https://your-frontend-domain.com
