NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/help_desk

# Required: generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_min_32_chars

# Required for AI ticket classification (server-side only, never exposed to
# the browser). The AI endpoint returns 503 when these are not set.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional per-request AI timeout in ms (minimum 1000, default 15000)
# GROQ_TIMEOUT_MS=15000

# Required in production: the exact origin of your frontend (no trailing slash)
# FRONTEND_ORIGIN=https://your-frontend-domain.com

# ---------------------------------------------------------------------------
# Invitation emails
# ---------------------------------------------------------------------------
# How invitation emails are delivered:
#   console (default) — log the invite link to the server console (dev only)
#   smtp              — send real email through the SMTP settings below.
#                       Requires nodemailer: npm i nodemailer
MAIL_TRANSPORT=console

# From address used on invitation emails (required for SMTP delivery)
MAIL_FROM="Help Desk <no-reply@example.com>"

# SMTP settings (only used when MAIL_TRANSPORT=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Base URL of the frontend, used to build invitation links in emails
FRONTEND_URL=http://localhost:5173
